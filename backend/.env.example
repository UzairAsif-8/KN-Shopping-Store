PORT=5000
NODE_ENV=development

# Set false for real Postgres (required on Render)
DUMMY_MODE=false

# Neon pooled URL (for the running app) — host usually contains "-pooler"
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Neon DIRECT (non-pooler) URL — required for prisma migrate on Render
# Same credentials, but host WITHOUT "-pooler"
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require

# Public API origin (no trailing slash) — used for absolute /uploads URLs
# Example on Render: https://kn-store-api.onrender.com
PUBLIC_API_URL=http://localhost:5000

# Required in production — use long random strings
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Admin credentials used by bootstrap/seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123

# Frontend origin(s) for CORS — set to your Render Static Site URL in production
FRONTEND_URL=http://localhost:5173
FRONTEND_ORIGINS=

# Cookie SameSite for split frontend/API hosting: none | lax | strict
# Production default is none (required for Render Static Site + Web Service)
COOKIE_SAME_SITE=

# Strongly recommended on Render (local disk uploads are ephemeral)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

MAX_FILE_SIZE=5242880
MAX_FILES=10
